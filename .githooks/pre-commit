#!/bin/sh
# Fast pre-commit check for omp-config: the repo's contracts must hold.
# The suite is milliseconds; lucidlint and the rest stay in `make test` + CI.
set -e
cd "$(git rev-parse --show-toplevel)"
[ -x .venv/bin/python ] || { echo "pre-commit: run 'make test' once to provision .venv"; exit 1; }
make -s check-python
.venv/bin/python -m unittest discover -s tools/tests
