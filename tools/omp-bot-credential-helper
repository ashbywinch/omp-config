#!/bin/bash
# Git credential helper for the omp-harness GitHub App installation token.
# Responds to `get` for github.com HTTPS with x-access-token credentials;
# every other operation/host exits 0 silently. The token is minted fresh per
# call (installation tokens expire hourly) and is never stored.
#
# Installed at ~/.local/libexec/omp-bot-credential-helper via
# `make install-git-shim`. Used by tools/git-app-shim.

set -euo pipefail

if [ "${1:-}" != "get" ]; then
    exit 0
fi

HOST=""
while IFS= read -r line; do
    case "$line" in
        host=*) HOST="${line#host=}" ;;
        protocol=*|username=*|path=*) : ;;
        "") break ;;
    esac
done

case "$HOST" in
    github.com|www.github.com) ;;
    *) exit 0 ;;
esac

# Home may be unset or wrong in daemon/bare-env contexts; resolve it.
if [ -z "${HOME:-}" ] || [ ! -d "$HOME" ]; then
    HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
fi

# App key material comes from ~/.secrets at runtime; nothing here prints it.
# shellcheck disable=SC1090
source "${HOME}/.secrets"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
NOW="$(date +%s)"
HDR="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
CLAIMS="$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((NOW - 60))" "$((NOW + 540))" "$GITHUB_APP_ID" | b64url)"
SIG="$(printf '%s' "$HDR.$CLAIMS" | openssl dgst -sha256 -sign "$GITHUB_APP_KEY_FILE" -binary | b64url)"
JWT="$HDR.$CLAIMS.$SIG"
TOKEN="$(curl -fsS -X POST \
    -H "Authorization: Bearer $JWT" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/$GITHUB_APP_INSTALLATION_ID/access_tokens" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])')"

printf 'username=x-access-token\npassword=%s\n' "$TOKEN"
