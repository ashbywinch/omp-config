#!/bin/bash
# Git credential helper for omp-harness agent-mode git.
# Registered GENERICALLY in the agent gitconfig, so every credential lookup
# routes through here:
#   - github.com            -> mint a fresh app installation token
#   - any other host        -> fail loudly with a helpful message (agents
#                              authenticate only as omp-harness[bot] on
#                              github.com; give the bot its own service
#                              account for other hosts if needed)
#   - non-agent context     -> silent (this helper is not in user git config)
#   - store/erase           -> silent
# The token is minted per call (installation tokens expire hourly) and never
# stored.
#
# Installed at ~/.local/libexec/omp-bot-credential-helper via
# `make install-git-shim`. Used by tools/git-app-shim.

set -euo pipefail

if [ "${1:-}" != "get" ]; then
    exit 0
fi

# Agent context only: the paseo agent wrapper exports OMP_GIT_IDENTITY=bot;
# PASEO_AGENT_ID is the compatibility bridge.
if [ "${OMP_GIT_IDENTITY:-}" != "bot" ] && [ -z "${PASEO_AGENT_ID:-}" ]; then
    exit 0
fi

HOST=""
while IFS= read -r line; do
    case "$line" in
        host=*) HOST="${line#host=}" ;;
        protocol=*|username=*|path=*) : ;;
        "") break ;;
    esac
done

case "$HOST" in
    github.com|www.github.com) ;;
    *)
        echo "agent-mode git has no credentials for '$HOST': agents authenticate only as omp-harness[bot] on github.com." >&2
        echo "To use '$HOST' from an agent, give the bot its own service account for '$HOST' and register it (see AGENTS.md, Git/GitHub auth)." >&2
        echo "To use your own credentials, run git outside agent context (OMP_GIT_IDENTITY=user)." >&2
        exit 1
        ;;
esac

# Home may be unset or wrong in daemon/bare-env contexts; resolve it.
if [ -z "${HOME:-}" ] || [ ! -d "$HOME" ]; then
    HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
fi

# App key material comes from ~/.secrets at runtime; validate it so a broken
# setup fails with an actionable message, not a cryptic git error.
if [ ! -f "${HOME}/.secrets" ]; then
    echo "omp-bot-credential-helper: ~/.secrets missing — run make install-git-shim to create it from the template" >&2
    exit 1
fi
# shellcheck disable=SC1090
source "${HOME}/.secrets"
for var in GITHUB_APP_ID GITHUB_APP_KEY_FILE GITHUB_APP_INSTALLATION_ID; do
    if [ -z "${!var:-}" ]; then
        echo "omp-bot-credential-helper: ~/.secrets is missing '$var' — fill it in (see tools/secrets.template)" >&2
        exit 1
    fi
done
if [ ! -f "${GITHUB_APP_KEY_FILE}" ]; then
    echo "omp-bot-credential-helper: GITHUB_APP_KEY_FILE ('${GITHUB_APP_KEY_FILE}') does not exist — check ~/.secrets" >&2
    exit 1
fi

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
NOW="$(date +%s)"
HDR="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
CLAIMS="$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((NOW - 60))" "$((NOW + 540))" "$GITHUB_APP_ID" | b64url)"
SIG="$(printf '%s' "$HDR.$CLAIMS" | openssl dgst -sha256 -sign "$GITHUB_APP_KEY_FILE" -binary | b64url)"
JWT="$HDR.$CLAIMS.$SIG"
TOKEN="$(curl -fsS -X POST \
    -H "Authorization: Bearer $JWT" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/$GITHUB_APP_INSTALLATION_ID/access_tokens" \
    2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])')" || {
    echo "omp-bot-credential-helper: failed to mint an omp-harness installation token — check ~/.secrets and the app installation" >&2
    exit 1
}

printf 'username=x-access-token\npassword=%s\n' "$TOKEN"
