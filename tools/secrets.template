# ~/.secrets — environment secrets sourced by ~/.paseo/start.sh (Paseo daemon)
# and by tools/gh-app-shim (GitHub App auth for omp).
#
# Apply on a new machine: copy this template to ~/.secrets, fill in values,
# then `chmod 600 ~/.secrets`. NEVER commit this file or its values.
#
# Every line must start with `export` — a bare `NAME=value` sets a shell
# variable that never reaches child processes (a real bug we hit).

# ---- Google ----
export GOOGLE_API_KEY=...
export GOOGLE_CLIENT_ID=...
export GOOGLE_CLIENT_SECRET=...

# ---- LLM providers ----
export OPENROUTER_API_KEY=...
export OPENCODE_GO_EVALS_API_KEY=...
export OPENCODE_GO_HOUSES_API_KEY=...
export EXA_API_KEY=...
export TFL_API_KEY=...
export HEIGIT_API_KEY=...

# ---- Places / maps ----
export PLACES_API_KEY=...

# ---- UK rail ----
export NATIONAL_RAIL_API_PASSWORD=...

# ---- Home data ----
export HOMEDATA_API_KEY=...
export EPC_BEARER_TOKEN=...
export BUS_DATA_API_KEY=...

# ---- Google Sheets ----
export GOOGLE_SHEETS_SERVICE_ACCOUNT="$(cat ~/.google-sheets-service-account.json)"
export HOUSES_SHEET_ID=...
export HOUSES_SESSION_SECRET=...

# ---- Paseo ----
export PASEO_PASSWORD=...

# ---- GitHub OAuth app (harness OAuth flow) ----
export GITHUB_OMP_CLIENTID=...
export GITHUB_OMP_SECRET=...

# ---- GitHub App (omp's machine identity for gh, via tools/gh-app-shim) ----
# App id and installation id are public identifiers; the key file is the
# secret (keep it 0600, never commit it).
export GITHUB_APP_ID=...
export GITHUB_APP_KEY_FILE="${HOME}/.config/github/omp-harness.private-key.pem"
export GITHUB_APP_INSTALLATION_ID=...
