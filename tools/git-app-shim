#!/bin/bash
# git shim: omp agents authenticate to GitHub as the omp-harness app (bot),
# never as the human user. Mirrors tools/gh-app-shim:
#   - OMP_GIT_IDENTITY=user   -> pass through to real git (explicit human)
#   - GH_TOKEN/GITHUB_TOKEN   -> pass through untouched (explicit override)
#   - stdin is a TTY          -> pass through (user's own terminal; agent
#                                runners must not allocate a PTY for git)
#   - otherwise (agent)       -> force the bot credential helper for
#                                github.com + the bot commit identity
#
# The gh shim covers the `gh` CLI; git is a separate binary whose credentials
# come from git's own credential helpers (the user's keyring found their
# stored credentials — pushes went out as the user). This shim closes that
# gap: in agent contexts every github.com HTTPS operation uses a freshly
# minted omp-harness app installation token, and every commit is authored
# `omp-harness[bot]`. SSH remotes are out of scope (credential helpers apply
# only to HTTPS) — agent repos must use HTTPS remotes.
#
# Installed as ~/.local/bin/git (earlier in PATH than real git) via
# `make install-git-shim`. Source-controlled: tools/git-app-shim.

set -euo pipefail

# Home may be unset or wrong in daemon/bare-env contexts; resolve it.
if [ -z "${HOME:-}" ] || [ ! -d "$HOME" ]; then
    HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
fi
export HOME

# ---- locate the real git (skip this shim's own directory) ----
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_GIT=""
IFS=':' read -ra DIRS <<< "${PATH:-}"
for d in "${DIRS[@]}"; do
    [ -n "$d" ] || continue
    if [ "$(cd "$d" 2>/dev/null && pwd)" = "$SELF_DIR" ]; then
        continue
    fi
    if [ -x "$d/git" ]; then
        REAL_GIT="$d/git"
        break
    fi
done
if [ -z "$REAL_GIT" ]; then
    echo "git shim: could not locate the real git binary" >&2
    exit 1
fi

# ---- minimum git version: GIT_CONFIG_GLOBAL needs 2.32+ ----
GIT_VERSION="$("$REAL_GIT" --version | sed -n 's/^git version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')"
GIT_MAJOR="${GIT_VERSION% *}"
GIT_MINOR="${GIT_VERSION#* }"
if [ "${GIT_MAJOR:-0}" -lt 2 ] || { [ "${GIT_MAJOR:-0}" -eq 2 ] && [ "${GIT_MINOR:-0}" -lt 32 ]; }; then
    echo "git shim: git >= 2.32 required (GIT_CONFIG_GLOBAL); found $("$REAL_GIT" --version) — refusing to run against the user's credential config" >&2
    exit 1
fi

# ---- pass-through cases (explicit overrides and the user's own terminal) ----
if [ -n "${GH_TOKEN:-}" ] || [ -n "${GITHUB_TOKEN:-}" ] || [ "${OMP_GIT_IDENTITY:-}" = "user" ]; then
    exec "$REAL_GIT" "$@"
fi
if [ -t 0 ] && [ "${OMP_GIT_IDENTITY:-}" != "bot" ]; then
    exec "$REAL_GIT" "$@"
fi

# ---- agent mode: bot identity + bot credentials for github.com ----
HELPER="${HOME}/.local/libexec/omp-bot-credential-helper"
if [ ! -x "$HELPER" ]; then
    echo "git shim: bot credential helper missing at $HELPER — run make install-git-shim" >&2
    exit 1
fi

# The user's ~/.gitconfig pins `credential.https://github.com.helper =
# !/usr/bin/gh auth git-credential` — an ABSOLUTE path that bypasses the gh
# shim and returns the user's stored token, so agents would push as the user.
# -c values only APPEND to that chain, so the shim replaces the global config
# entirely (generated once, preserving init.defaultBranch) and sets the bot
# identity explicitly.
AGENT_CONFIG="${HOME}/.local/etc/gitconfig-agent"
if [ ! -f "$AGENT_CONFIG" ]; then
    mkdir -p "$(dirname "$AGENT_CONFIG")"
    cat > "$AGENT_CONFIG" <<EOF
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = ${HELPER}
EOF
fi
export GIT_CONFIG_GLOBAL="$AGENT_CONFIG"
exec "$REAL_GIT" \
    -c "credential.https://github.com.helper=${HELPER}" \
    -c user.name="omp-harness[bot]" \
    -c user.email="316112947+omp-harness[bot]@users.noreply.github.com" \
    "$@"
