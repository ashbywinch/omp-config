#!/bin/bash
# git shim: omp agents authenticate to GitHub as the omp-harness app (bot),
# never as the human user.
#
# Context detection is explicit, not TTY-based:
#   - OMP_GIT_IDENTITY=user   -> pass through to real git (explicit human)
#   - OMP_GIT_IDENTITY=bot    -> agent mode (explicit bot)
#   - PASEO_AGENT_ID set      -> agent mode (the omp harness sets this for
#                                every agent process, PTY or not)
#   - otherwise               -> pass through (user's terminal, IDE, scripts,
#                                CI jobs — none of them are the omp agent)
#
# In agent mode the shim forces the bot credential helper for github.com and
# the omp-harness[bot] commit identity, and replaces the user's global
# gitconfig (whose `credential.https://github.com.helper = !/usr/bin/gh auth
# git-credential` absolute path bypasses the gh shim and would return the
# user's stored token). -c values only APPEND to that helper chain, so the
# replacement is done via GIT_CONFIG_GLOBAL (git >= 2.32).
#
# SSH remotes are out of scope: credential helpers apply only to HTTPS, so
# agent repos must use HTTPS remotes.
#
# Installed as ~/.local/bin/git (earlier in PATH than real git) via
# `make install-git-shim`. Source-controlled: tools/git-app-shim.

set -euo pipefail

# Home may be unset or wrong in daemon/bare-env contexts; resolve it.
if [ -z "${HOME:-}" ] || [ ! -d "$HOME" ]; then
    HOME="$(getent passwd "$(id -u)" | cut -d: -f6)"
fi
export HOME

# ---- locate the real git (skip this shim's own directory) ----
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_GIT=""
IFS=':' read -ra DIRS <<< "${PATH:-}"
for d in "${DIRS[@]}"; do
    [ -n "$d" ] || continue
    if [ "$(cd "$d" 2>/dev/null && pwd)" = "$SELF_DIR" ]; then
        continue
    fi
    if [ -x "$d/git" ]; then
        REAL_GIT="$d/git"
        break
    fi
done
if [ -z "$REAL_GIT" ]; then
    echo "git shim: could not locate the real git binary" >&2
    exit 1
fi

# ---- identity decision ----
# Agent context (PASEO_AGENT_ID, set by the omp harness for every agent
# process) ALWAYS wins: a user-exported OMP_GIT_IDENTITY cannot disable it.
# Outside agent context, OMP_GIT_IDENTITY is the explicit override; with no
# explicit identity it is a user context (terminal, IDE, scripts, CI).
AGENT_MODE=""
if [ -n "${PASEO_AGENT_ID:-}" ]; then
    AGENT_MODE=1
elif [ "${OMP_GIT_IDENTITY:-}" = "bot" ]; then
    AGENT_MODE=1
elif [ "${OMP_GIT_IDENTITY:-}" = "user" ]; then
    exec "$REAL_GIT" "$@"
else
    exec "$REAL_GIT" "$@"
fi

if [ -n "$AGENT_MODE" ]; then
    # GIT_CONFIG_GLOBAL is honored only by git >= 2.32; older git would keep
    # the user's gitconfig and leak their token. Fail closed — including on
    # any version string that cannot be parsed.
    GIT_VERSION="$("$REAL_GIT" --version 2>/dev/null || true)"
    case "$GIT_VERSION" in
        git\ version\ [0-9]*.[0-9]*.*)
            GIT_MAJOR="$(printf '%s' "$GIT_VERSION" | sed -n 's/^git version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1/p')"
            GIT_MINOR="$(printf '%s' "$GIT_VERSION" | sed -n 's/^git version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\2/p')"
            ;;
        *)
            echo "git shim: cannot parse git version ('$GIT_VERSION') — refusing agent mode (fail closed)" >&2
            exit 1
            ;;
    esac
    if [ "${GIT_MAJOR:-0}" -lt 2 ] || { [ "${GIT_MAJOR:-0}" -eq 2 ] && [ "${GIT_MINOR:-0}" -lt 32 ]; }; then
        echo "git shim: agent mode requires git >= 2.32 (GIT_CONFIG_GLOBAL); found $GIT_VERSION — refusing to run against the user's credential config" >&2
        exit 1
    fi

    HELPER="${HOME}/.local/libexec/omp-bot-credential-helper"
    if [ ! -x "$HELPER" ]; then
        echo "git shim: bot credential helper missing at $HELPER — run make install-git-shim" >&2
        exit 1
    fi

    # The user's ~/.gitconfig pins an absolute-path gh credential helper that
    # bypasses the gh shim; replace the global config entirely. Preserve the
    # user's init.defaultBranch (read live; fall back to main).
    DBRANCH="$("$REAL_GIT" config --global init.defaultBranch 2>/dev/null || true)"
    [ -n "$DBRANCH" ] || DBRANCH="main"
    AGENT_CONFIG="${HOME}/.local/etc/gitconfig-agent"
    mkdir -p "$(dirname "$AGENT_CONFIG")"
    if [ ! -f "$AGENT_CONFIG" ] || ! grep -q "defaultBranch = $DBRANCH" "$AGENT_CONFIG"; then
        cat > "$AGENT_CONFIG" <<EOF
[init]
	defaultBranch = ${DBRANCH}
[credential "https://github.com"]
	helper = ${HELPER}
EOF
    fi
    export GIT_CONFIG_GLOBAL="$AGENT_CONFIG"
    # Drop the system scope too (/etc/gitconfig): a system-level credential
    # helper would stay in the chain ahead of the bot helper.
    export GIT_CONFIG_NOSYSTEM=1
    exec "$REAL_GIT" \
        -c "credential.https://github.com.helper=${HELPER}" \
        -c user.name="omp-harness[bot]" \
        -c user.email="316112947+omp-harness[bot]@users.noreply.github.com" \
        "$@"
fi

# ---- user context (terminal, IDE, scripts, CI): untouched ----
exec "$REAL_GIT" "$@"
